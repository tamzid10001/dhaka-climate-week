{
  "directoryListing": false,
  "symlinks": false,
  "redirects": [
    { "source": "/.*", "destination": "/not-found", "type": 302 },
    { "source": "/node_modules/**", "destination": "/not-found", "type": 302 },
    { "source": "/user_read_only_context/**", "destination": "/not-found", "type": 302 },
    { "source": "/v0_memories/**", "destination": "/not-found", "type": 302 },
    { "source": "/package.json", "destination": "/not-found", "type": 302 },
    { "source": "/pnpm-lock.yaml", "destination": "/not-found", "type": 302 },
    { "source": "/serve.json", "destination": "/not-found", "type": 302 }
  ]
}
